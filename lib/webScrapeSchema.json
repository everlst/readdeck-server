{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:readdeck:WebScrapeResultV1",
  "title": "WebScrapeResultV1",
  "description": "AI 联网刮削的最终输出格式参考。尽可能完整收集主作品、创作人员、角色、关联作品及本批卷册的资料和图片。展示名称、标签、简介、职责、声优和关系均使用简体中文；优先使用 Bangumi 简体中文名、中文名及中文简介，没有中文的部分直接翻译。originalName 和来源摘录保留原文。资料由 AI 自主确认，程序不按本 Schema 或工具来源记录验收、驳回或改写内容。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "reason", "work", "persons", "characters", "relations", "resources", "sources", "fieldSources"],
  "properties": {
    "schemaVersion": {"const": 1},
    "status": {"enum": ["success", "partial", "failed"]},
    "reason": {"$ref": "#/definitions/text"},
    "work": {"anyOf": [{"$ref": "#/definitions/work"}, {"type": "null"}]},
    "persons": {"type": "array", "maxItems": 128, "items": {"$ref": "#/definitions/person"}},
    "characters": {"type": "array", "maxItems": 128, "items": {"$ref": "#/definitions/character"}},
    "relations": {"type": "array", "maxItems": 128, "items": {"$ref": "#/definitions/relation"}},
    "resources": {"type": "array", "maxItems": 8, "items": {"$ref": "#/definitions/resource"}},
    "sources": {
      "type": "array", "maxItems": 512,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "url", "title", "excerpt"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9_-]+$"},
          "url": {"$ref": "#/definitions/url"},
          "title": {"$ref": "#/definitions/name"},
          "excerpt": {"$ref": "#/definitions/text"}
        }
      }
    },
    "fieldSources": {
      "description": "以 JSON Pointer 记录重要字段采用的资料来源，供展示和追溯；直接翻译时可指向原文来源页面，并用 titleOrigin=translation 区分译名。sources 和 fieldSources 不与接口的工具记录逐项比对，不必为了引用记录重复搜索。",
      "type": "array", "maxItems": 4096,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["field", "sourceIds"],
        "properties": {
          "field": {"type": "string", "maxLength": 256, "pattern": "^/(work|persons|characters|relations|resources)/"},
          "sourceIds": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80}}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "failed"}}},
      "then": {
        "properties": {
          "reason": {"minLength": 1}, "work": {"type": "null"},
          "persons": {"maxItems": 0}, "characters": {"maxItems": 0}, "relations": {"maxItems": 0},
          "resources": {"items": {"properties": {"status": {"const": "failed"}}}}
        }
      }
    },
    {"if": {"properties": {"status": {"const": "partial"}}}, "then": {"properties": {"reason": {"minLength": 1}}}}
  ],
  "definitions": {
    "name": {"type": "string", "maxLength": 1024},
    "text": {"type":"string","maxLength":32000},
    "names": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
    "url": {"type": "string", "maxLength": 2048, "format": "web-url"},
    "image": {"anyOf":[{"const":""},{"$ref":"#/definitions/url"}],"description":"实际图片文件 URL；作品/卷册/关联作品为封面，人物/角色为头像或角色图。主动从条目图片或官方 API images 中收集，优先 original/large，其次可用的 common/medium/small；不要根据 ID 猜测图片路径。"},
    "urls": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/definitions/url"}},
    "id": {"description":"实际 Bangumi 条目 ID，保持数字；没有对应 Bangumi 条目则为 null。由 AI 根据所查资料确定，不使用虚构 ID 代替其他网站的实体。","type":["integer","null"],"minimum":1,"maximum":9007199254740991},
    "number": {"type": ["number", "null"], "minimum": 0, "maximum": 9007199254740991},
    "origin": {"enum": ["bangumi", "web", "translation", "local"]},
    "mediaType": {"enum": ["novel", "comic", "anime", "artbook", "other", ""]},
    "work": {
      "type": "object", "additionalProperties": false,
      "required": ["originalName", "nameCn", "aliases", "mediaType", "authors", "publishers", "date", "status", "tags", "summary", "coverUrl", "bangumiId", "sourceUrls", "titleOrigin"],
      "properties": {
        "originalName": {"$ref": "#/definitions/name"}, "nameCn": {"$ref": "#/definitions/name"},
        "aliases": {"$ref": "#/definitions/names"}, "mediaType": {"$ref": "#/definitions/mediaType"},
        "authors": {"$ref": "#/definitions/names"}, "publishers": {"$ref": "#/definitions/names"},
        "date": {"$ref": "#/definitions/name"}, "status": {"$ref": "#/definitions/name"},
        "tags": {"$ref": "#/definitions/names"}, "summary": {"$ref": "#/definitions/text"},
        "coverUrl": {"$ref": "#/definitions/image"}, "bangumiId": {"$ref": "#/definitions/id"},
        "sourceUrls": {"$ref": "#/definitions/urls"}, "titleOrigin": {"$ref": "#/definitions/origin"}
      }
    },
    "person": {
      "type": "object", "additionalProperties": false,
      "required": ["originalName","nameCn","roles","summary","bangumiId","sourceUrls","titleOrigin","coverUrl"],
      "properties": {
        "originalName": {"$ref": "#/definitions/name"}, "nameCn": {"$ref": "#/definitions/name"},
        "roles": {"$ref": "#/definitions/names"}, "summary": {"$ref": "#/definitions/text"},
        "bangumiId": {"$ref": "#/definitions/id"}, "sourceUrls": {"$ref": "#/definitions/urls"}, "titleOrigin": {"$ref": "#/definitions/origin"},
        "coverUrl": {"$ref":"#/definitions/image","description":"该人物头像或角色图片的实际原图/大图直链，优先使用 Bangumi。"}
      }
    },
    "character": {
      "type": "object", "additionalProperties": false,
      "required": ["originalName","nameCn","summary","voiceActors","bangumiId","sourceUrls","titleOrigin","coverUrl"],
      "properties": {
        "originalName": {"$ref": "#/definitions/name"}, "nameCn": {"$ref": "#/definitions/name"},
        "summary": {"$ref": "#/definitions/text"}, "voiceActors": {"$ref": "#/definitions/names"},
        "bangumiId": {"$ref": "#/definitions/id"}, "sourceUrls": {"$ref": "#/definitions/urls"}, "titleOrigin": {"$ref": "#/definitions/origin"},
        "coverUrl": {"$ref":"#/definitions/image","description":"该人物头像或角色图片的实际原图/大图直链，优先使用 Bangumi。"}
      }
    },
    "relation": {
      "type": "object", "additionalProperties": false,
      "required": ["originalName", "nameCn", "mediaType", "relation", "coverUrl", "bangumiId", "sourceUrls", "titleOrigin"],
      "properties": {
        "originalName": {"$ref": "#/definitions/name"}, "nameCn": {"$ref": "#/definitions/name"},
        "mediaType": {"$ref": "#/definitions/mediaType"}, "relation": {"$ref": "#/definitions/name"},
        "coverUrl": {"$ref": "#/definitions/image"}, "bangumiId": {"$ref": "#/definitions/id"},
        "sourceUrls": {"$ref": "#/definitions/urls"}, "titleOrigin": {"$ref": "#/definitions/origin"}
      }
    },
    "resource": {
      "type": "object", "additionalProperties": false,
      "required": ["resourceId", "status", "reason", "originalName", "nameCn", "volumeNumber", "chapterNumber", "volumeEnd", "chapterEnd", "summary", "coverUrl", "bangumiId", "sourceUrls", "titleOrigin"],
      "properties": {
        "resourceId": {"type": "string", "minLength": 1, "maxLength": 512},
        "status": {"enum": ["success", "failed"]}, "reason": {"$ref": "#/definitions/text"},
        "originalName": {"$ref": "#/definitions/name"}, "nameCn": {"$ref": "#/definitions/name"},
        "volumeNumber": {"$ref": "#/definitions/number"}, "chapterNumber": {"type": "null", "description": "章节不参与元数据刮削，保留字段仅用于兼容。"},
        "volumeEnd": {"$ref": "#/definitions/number"}, "chapterEnd": {"type": "null"},
        "summary": {"$ref": "#/definitions/text"}, "coverUrl": {"$ref": "#/definitions/image"},
        "bangumiId": {"$ref": "#/definitions/id"}, "sourceUrls": {"$ref": "#/definitions/urls"}, "titleOrigin": {"$ref": "#/definitions/origin"}
      },
      "allOf": [{"if": {"properties": {"status": {"const": "failed"}}}, "then": {"properties": {"reason": {"minLength": 1}, "bangumiId": {"type": "null"}}}}]
    }
  }
}
